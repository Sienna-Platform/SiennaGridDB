        "r_23": {"unit_base": {"base_power_ref": "base_power_23", "base_voltage_ref": "primary_circuit->transformer_circuits.base_voltage_primary"}},
        "x_23": {"unit_base": {"base_power_ref": "base_power_23", "base_voltage_ref": "primary_circuit->transformer_circuits.base_voltage_primary"}},
        "r_31": {"unit_base": {"base_power_ref": "base_power_31", "base_voltage_ref": "primary_circuit->transformer_circuits.base_voltage_primary"}},
        "x_31": {"unit_base": {"base_power_ref": "base_power_31", "base_voltage_ref": "primary_circuit->transformer_circuits.base_voltage_primary"}},
        "parameter_units": {},
        "base_power_12": {"checks": ["base_power_12 > 0"]},
        "base_power_23": {"checks": ["base_power_23 > 0"]},
        "base_power_31": {"checks": ["base_power_31 > 0"]},
        "magnetizing_shunt": {"hand_units": true},
        "shunt_location": {}
      },
      "skip": ["admittance_units"],
      "constraints": ["CHECK (primary_circuit <> secondary_circuit AND primary_circuit <> tertiary_circuit AND secondary_circuit <> tertiary_circuit)", "CHECK ((r_12 IS NULL) + (x_12 IS NULL) + (r_23 IS NULL) + (x_23 IS NULL) + (r_31 IS NULL) + (x_31 IS NULL) + (base_power_12 IS NULL) + (base_power_23 IS NULL) + (base_power_31 IS NULL) IN (0, 9))"],
      "indexes": ["CREATE UNIQUE INDEX idx_three_winding_transformers_primary_circuit ON three_winding_transformers (primary_circuit)", "CREATE UNIQUE INDEX idx_three_winding_transformers_secondary_circuit ON three_winding_transformers (secondary_circuit)", "CREATE UNIQUE INDEX idx_three_winding_transformers_tertiary_circuit ON three_winding_transformers (tertiary_circuit)", "CREATE INDEX idx_three_winding_transformers_star_bus ON three_winding_transformers (star_bus)"]
    },
    "two_terminal_hvdc_lines": {
      "comment": [
        "Point-to-point (two-terminal) HVDC line, one table for all three PSY variants",
        "(Generic/LCC/VSC), discriminated by converter_type. Only fields common to",
        "all three are columns; variant-specific fields (LCC rectifier/inverter",
        "detail, VSC controls, loss curves) live in the generic attributes table.",
        "Both terminals are AC buses, DC side internal -- unlike tmodel_hvdc_lines,",
        "which runs between DC buses for multi-terminal networks."
      ],
      "columns": {
        "id": {},
        "name": {},
        "arc": {"column": "arc_id", "references": "arcs (id) ON DELETE CASCADE"},
        "converter_type": {"sql": "TEXT NOT NULL DEFAULT 'GENERIC' CHECK (converter_type IN ('GENERIC', 'LCC', 'VSC'))"},
        "available": {"default": 1},
        "base_power": {"checks": ["base_power > 0"]},
        "power_units": {},
        "active_power_flow": {"default": 0.0},
        "rating": {"checks": ["rating >= 0"]},
        "rating_from": {"checks": ["rating_from >= 0"]},
        "rating_to": {"checks": ["rating_to >= 0"]},
        "reactive_power_limits_from": {},
        "reactive_power_limits_to": {},
        "operational_flow_limit": {}
      },
      "attribute_channel": ["loss", "r", "power_transfer_setpoint", "current_transfer_setpoint", "scheduled_dc_voltage", "rectifier_bridges", "rectifier_delay_angle_limits", "rectifier_rc", "rectifier_xc", "rectifier_base_voltage", "inverter_bridges", "inverter_extinction_angle_limits", "inverter_rc", "inverter_xc", "inverter_base_voltage", "control_mode", "switch_mode_voltage", "compounding_resistance", "min_compounding_voltage", "rectifier_transformer_ratio", "rectifier_tap_setting", "rectifier_tap_limits", "rectifier_tap_step", "rectifier_delay_angle", "rectifier_capacitor_reactance", "inverter_transformer_ratio", "inverter_tap_setting", "inverter_tap_limits", "inverter_tap_step", "inverter_extinction_angle", "inverter_capacitor_reactance", "g", "dc_current", "reactive_power_from", "dc_control_from", "ac_control_from", "dc_power_setpoint_from", "dc_voltage_setpoint_from", "power_factor_setpoint_from", "ac_voltage_setpoint_from", "rated_ac_voltage_from", "converter_loss_from", "max_dc_current_from", "power_factor_weighting_fraction_from", "voltage_limits_from", "dc_voltage_droop_from", "reactive_power_to", "dc_control_to", "ac_control_to", "dc_power_setpoint_to", "dc_voltage_setpoint_to", "power_factor_setpoint_to", "ac_voltage_setpoint_to", "rated_ac_voltage_to", "converter_loss_to", "max_dc_current_to", "power_factor_weighting_fraction_to", "voltage_limits_to", "dc_voltage_droop_to", "rated_dc_voltage", "remote_bus_control_from", "remote_bus_control_to"]
    },
    "tmodel_hvdc_lines": {
      "comment": [
        "T-model HVDC line (PSY TModelHVDCLine): a DC-network element whose arc",
        "endpoints must both be DC buses (entity_types.is_dc = 1), enforced by",
        "enforce_tmodel_hvdc_lines_arc_domain. It is the multi-terminal building",
        "block, paired with interconnecting_converters at each AC/DC boundary --",
        "use two_terminal_hvdc_lines for point-to-point HVDC. r, l and c are natural",
        "units only. base_current, not base_power, is the row's base: the DC line",
        "current is the value that is actually known."
      ],
      "columns": {
        "id": {},
        "name": {},
        "arc": {"column": "arc_id", "references": "arcs (id) ON DELETE CASCADE"},
        "r": {},
        "base_current": {"checks": ["base_current > 0"]},
        "available": {"default": 1},
        "active_power_flow": {"default": 0.0},
        "l": {},
        "c": {},
        "operational_flow_limit": {}
      }
    },
    "synchronous_condensers": {
      "comment": [
        "Synchronous machine for inertia or reactive support (PSY SynchronousCondenser).",
        "It injects no active power, so there is no active_power column;",
        "active_power_losses is the loss incurred by being online. Power-family",
        "columns follow power_units (COMPONENT_BASE -> pu; NATURAL_UNITS -> physical unit)."
      ],
      "columns": {
        "id": {},
        "name": {},
        "bus": {"references": "balancing_topologies (id) ON DELETE CASCADE"},
        "available": {"default": 1},
        "reactive_power": {"default": 0.0},
        "rating": {"checks": ["rating > 0"]},
        "base_power": {"checks": ["base_power > 0"]},
        "power_units": {},
        "reactive_power_limits": {},
        "active_power_losses": {"checks": ["active_power_losses >= 0"]}
      },
      "skip": ["dynamic_injector"]
    },
    "fixed_admittance": {
      "comment": [
        "Fixed shunt admittance (PSY FixedAdmittance): Y as conductance (y_g) and",
        "susceptance (y_b). admittance_units is NATURAL_UNITS (siemens) or",
        "COMPONENT_MVAR (MW/MVAr at unity voltage, PSS/E native) -- no per-unit arm,",
        "since a shunt has no MVA rating; base_power is just the recorded base."
      ],
      "columns": {
        "id": {},
        "name": {},
        "bus": {"references": "balancing_topologies (id) ON DELETE CASCADE"},
        "available": {"default": 1},
        "y_g": {"sql": "REAL NOT NULL DEFAULT 0.0"},
        "y_b": {"sql": "REAL NOT NULL DEFAULT 0.0"},
        "admittance_units": {},
        "base_power": {"checks": ["base_power > 0"]}
      },
      "skip": ["dynamic_injector"],
      "decomposed": {"Y": ["y_g", "y_b"]}
    },
    "switched_admittance": {
      "comment": [
        "Switched shunt admittance (PSY SwitchedAdmittance). Effective admittance is",
        "number_engaged * Y_increase, or solved_admittance when present.",
        "admittance_units is NATURAL_UNITS (siemens) or COMPONENT_MVAR (MW/MVAr at",
        "unity voltage, PSS/E native). No base_power: neither basis needs one."
      ],
      "columns": {
        "id": {},
        "name": {},
        "bus": {"references": "balancing_topologies (id) ON DELETE CASCADE"},
        "available": {"default": 1},
        "admittance_units": {},
        "Y_increase": {},
        "number_engaged": {},
        "number_of_steps": {},
        "solved_admittance": {},
        "control_mode": {},
        "regulated_bus_number": {},
        "voltage_limits": {"unit_base": {"base_voltage_ref": "bus->balancing_topologies.base_voltage"}},
        "reactive_power_range_limits": {}
      },
      "skip": ["dynamic_injector"]
    },
    "sources": {
      "comment": [
        "Thevenin equivalent source (PSY Source). r_th/x_th follow parameter_units: pu on",
        "base_power, or natural-units ohm; COMPONENT_BASE is the default since PSY",
        "has no native external representation for this component. Column names are",
        "lowercase (the schemas spell R_th/X_th) -- a naming difference only, see",
        "sql_codegen_map.json. Power-family columns follow power_units instead,",
        "independent of parameter_units."
      ],
      "columns": {
        "id": {},
        "name": {},
        "bus": {"references": "balancing_topologies (id) ON DELETE CASCADE"},
        "available": {"default": 1},
        "base_voltage": {"checks": ["base_voltage > 0"]},
        "base_power": {"checks": ["base_power > 0"]},
        "power_units": {},
        "active_power": {},
        "reactive_power": {},
        "active_power_limits": {},
        "reactive_power_limits": {},
        "internal_voltage": {"checks": ["internal_voltage >= 0"]},
        "internal_angle": {},
        "R_th": {"column": "r_th"},
        "X_th": {"column": "x_th"},
        "parameter_units": {},
        "operation_cost": {"default": {"import_offer_curves": null, "export_offer_curves": null, "energy_import_weekly_limit": 1000000.0, "energy_export_weekly_limit": 1000000.0, "ancillary_service_offers": []}}
      },
      "skip": ["dynamic_injector"]
    },
    "interconnecting_converters": {
      "comment": [
        "Interconnecting power converter (PSY InterconnectingConverter), an AC<->DC",
        "bus converter. bus is the AC side, dc_bus the DC side; the domain of each is",
        "enforced by enforce_interconnecting_converters_bus_domain, since a plain FK",
        "cannot see the entity_types.is_dc flag. Each setpoint has one fixed unit."
      ],
      "columns": {
        "id": {},
        "name": {},
        "bus": {"references": "balancing_topologies (id) ON DELETE CASCADE"},
        "dc_bus": {"references": "balancing_topologies (id) ON DELETE CASCADE"},
        "dc_control": {"not_null": true, "default": "DC_VOLTAGE"},
        "ac_control": {"not_null": true, "default": "AC_REACTIVE_POWER"},
        "base_power": {"checks": ["base_power > 0"]},
        "power_units": {},
        "remote_bus_control": {"checks": ["remote_bus_control >= 1"]},
        "power_factor_weighting_fraction": {"checks": ["power_factor_weighting_fraction >= 0"]},
        "voltage_limits": {},
        "available": {"default": 1},
        "active_power": {},
        "rating": {},
        "active_power_limits": {},
        "reactive_power_limits": {},
        "dc_power_setpoint": {},
        "dc_voltage_setpoint": {},
        "power_factor_setpoint": {},
        "ac_voltage_setpoint": {}
      },
      "attribute_channel": ["dc_current", "max_dc_current", "loss_function", "dc_voltage_droop"],
      "skip": ["dynamic_injector"],
      "constraints": ["CHECK (bus <> dc_bus)"]
    },
    "facts_control_devices": {
      "comment": [
        "FACTS control device (PSY FACTSControlDevice). voltage_setpoint is stored flexibly",
        "per parameter_units (COMPONENT_BASE: pu on bus base_voltage, the native external form;",
        "NATURAL_UNITS: kV). power_units is a second, independent discriminator governing",
        "max_reactive_power (COMPONENT_BASE: pu; NATURAL_UNITS: MVAr)."
      ],
      "columns": {
        "id": {},
        "name": {},
        "bus": {"references": "balancing_topologies (id) ON DELETE CASCADE"},
        "voltage_setpoint": {"unit_base": {"base_voltage_ref": "bus->balancing_topologies.base_voltage"}},
        "voltage_setpoint_units": {"column": "parameter_units"},
        "base_power": {"checks": ["base_power > 0"]},
        "power_units": {},
        "max_reactive_power": {"checks": ["max_reactive_power >= 0"]},
        "shunt_control_type": {},
        "regulated_bus_number": {},
        "available": {"default": 1},
        "control_mode": {},
        "max_shunt_current": {},
        "reactive_power_required": {}
      },
      "skip": ["dynamic_injector"]
    },
    "balancing_topologies": {
      "comment": [
        "Balancing topologies for the system: buses (ACBus, DCBus) or larger aggregated",
        "regions (LoadZone). load_zone and area reference other rows. load_zone is a",
        "same-table reference, so its FK is deferred: a bus row may precede its zone row."
      ],
      "columns": {
        "id": {},
        "name": {},
        "area": {"references": "planning_regions (id) ON DELETE SET NULL"},
        "description": {"sql": "TEXT NULL"},
        "base_voltage": {"checks": ["base_voltage > 0"]},
        "number": {},
        "available": {"default": 1},
        "bustype": {},
        "angle": {},
        "magnitude": {},
        "voltage_limits": {},
        "load_zone": {"references": "balancing_topologies (id) ON DELETE SET NULL DEFERRABLE INITIALLY DEFERRED"}
      },
      "attribute_channel": ["peak_active_power", "peak_reactive_power", "base_power"],
      "skip": ["power_units"]
    },
    "supply_technologies": {
