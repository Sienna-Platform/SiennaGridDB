        "operation_costs": {"not_null": true, "default": {"cost_type": "THERMAL", "fixed": 0, "shut_down": 0, "start_up": 0, "variable": {"variable_cost_type": "COST", "power_units": "NATURAL_UNITS", "value_curve": {"curve_type": "INPUT_OUTPUT", "function_data": {"function_type": "LINEAR", "proportional_term": 0, "constant_term": 0}}, "vom_cost": {"curve_type": "INPUT_OUTPUT", "function_data": {"function_type": "LINEAR", "proportional_term": 0, "constant_term": 0}}}}},
        "financial_data": {}
      }
    },
    "storage_technologies": {
      "columns": {
        "id": {},
        "name": {},
        "prime_mover_type": {"references": "prime_mover_types(name)"},
        "storage_tech": {},
        "region": {"not_null": true},
        "power_systems_type": {},
        "lifetime": {},
        "unit_size_charge": {},
        "unit_size_discharge": {},
        "unit_size_energy": {},
        "capacity_limits_charge": {},
        "capacity_limits_discharge": {},
        "capacity_limits_energy": {},
        "available": {"default": 1},
        "duration_limits": {},
        "efficiency": {},
        "min_discharge_fraction": {},
        "losses": {},
        "capital_costs_charge": {"sql": "TEXT NULL"},
        "capital_costs_discharge": {"sql": "TEXT NOT NULL DEFAULT '{\"curve_type\": \"INPUT_OUTPUT\", \"function_data\": {\"function_type\": \"LINEAR\", \"proportional_term\": 0, \"constant_term\": 0}}'"},
        "capital_costs_energy": {"sql": "TEXT NOT NULL DEFAULT '{\"curve_type\": \"INPUT_OUTPUT\", \"function_data\": {\"function_type\": \"LINEAR\", \"proportional_term\": 0, \"constant_term\": 0}}'"},
        "interconnection_cost": {"sql": "REAL NOT NULL DEFAULT 0.0"},
        "operation_costs": {"not_null": true, "default": {"cost_type": "THERMAL", "fixed": 0, "shut_down": 0, "start_up": 0, "variable": {"variable_cost_type": "COST", "power_units": "NATURAL_UNITS", "value_curve": {"curve_type": "INPUT_OUTPUT", "function_data": {"function_type": "LINEAR", "proportional_term": 0, "constant_term": 0}}, "vom_cost": {"curve_type": "INPUT_OUTPUT", "function_data": {"function_type": "LINEAR", "proportional_term": 0, "constant_term": 0}}}}},
        "financial_data": {}
